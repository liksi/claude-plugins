{
  "$schema": "https://code.claude.com/schemas/marketplace.json",
  "name": "liksi-tools",
  "owner": {
    "name": "Liksi",
    "email": "tech@liksi.fr"
  },
  "description": "Plugins internes Liksi pour Claude Code",
  "plugins": [
    {
      "name": "critique-content",
      "source": "./plugins/critique-content",
      "description": "Critique structurée et honnête d'un contenu tech/conseil (slides, article, doc)",
      "version": "1.0.0",
      "category": "content",
      "skills": ["critique-content"],
      "author": {
        "name": "Liksi"
      }
    },
    {
      "name": "deslopify",
      "source": "./plugins/deslopify",
      "description": "Supprime les tropes IA d'un texte pour lui donner un ton naturel et authentique",
      "version": "1.0.0",
      "category": "content",
      "skills": ["deslopify"],
      "author": {
        "name": "Liksi"
      }
    },
    {
      "name": "linkedin-post",
      "source": "./plugins/linkedin-post",
      "description": "Génère un post LinkedIn concis et expert à partir d'un article de blog Liksi",
      "version": "1.0.0",
      "category": "marketing",
      "skills": ["linkedin-post"],
      "author": {
        "name": "Liksi"
      }
    },
    {
      "name": "playwright-mcp",
      "source": "./plugins/playwright-mcp",
      "description": "Automatisation navigateur via Playwright MCP",
      "version": "1.0.0",
      "category": "automation",
      "author": {
        "name": "Liksi"
      },
      "mcpServers": {
        "playwright": {
          "command": "npx",
          "args": ["@playwright/mcp@latest"]
        }
      }
    },
    {
      "name": "context7-mcp",
      "source": "./plugins/context7-mcp",
      "description": "Documentation à jour des librairies via Context7 MCP",
      "version": "1.0.0",
      "category": "developer-tools",
      "author": {
        "name": "Liksi"
      },
      "mcpServers": {
        "context7": {
          "command": "npx",
          "args": ["-y", "@upstash/context7-mcp@latest"]
        }
      }
    },
    {
      "name": "sequential-thinking-mcp",
      "source": "./plugins/sequential-thinking-mcp",
      "description": "Raisonnement structuré étape par étape via Sequential Thinking MCP",
      "version": "1.0.0",
      "category": "developer-tools",
      "author": {
        "name": "Liksi"
      },
      "mcpServers": {
        "sequential-thinking": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@latest"]
        }
      }
    },
    {
      "name": "a11y-mcp",
      "source": "./plugins/a11y-mcp",
      "description": "Audit d'accessibilité (WCAG) via a11y MCP",
      "version": "1.0.0",
      "category": "developer-tools",
      "author": {
        "name": "Liksi"
      },
      "mcpServers": {
        "priyankark-a11y-mcp": {
          "command": "npx",
          "args": ["a11y-mcp"]
        }
      }
    },
    {
      "name": "atlassian-mcp",
      "source": "./plugins/atlassian-mcp",
      "description": "Intégration Jira et Confluence via Atlassian MCP",
      "version": "1.0.0",
      "category": "developer-tools",
      "author": {
        "name": "Liksi"
      },
      "mcpServers": {
        "atlassian": {
          "url": "https://mcp.atlassian.com/v1/mcp/authv2"
        }
      }
    }
  ]
}
